<launch>
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <arg name="camera_info_topic" default="/usb_cam/camera_info"/>
  <arg name="start_usb_cam" default="true"/>
  <arg name="start_mapper" default="true"/>
  <arg name="map_frame" default="map"/>
  <arg name="detect_rate_hz" default="10.0"/>
  <arg name="publish_debug_image" default="true"/>
  <arg name="label" default="doll"/>
  <arg name="target_width_m" default="0.10"/>
  <arg name="target_height_m" default="0.16"/>
  <arg name="confirm_hits" default="2"/>
  <arg name="one_shot_mode" default="false"/>
  <arg name="use_latest_tf" default="true"/>
  <arg name="confidence_min" default="0.2"/>
  <arg name="cluster_radius_m" default="1.5"/>
  <arg name="save_landmarks" default="true"/>
  <arg name="landmark_file" default="$(env HOME)/.ros/doll_landmarks.json"/>

  <include if="$(arg start_usb_cam)" file="$(find usb_cam)/launch/usb_cam-test.launch"/>

  <node pkg="doll_map_annotator" type="doll_detector.py" name="doll_detector" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="detect_rate_hz" value="$(arg detect_rate_hz)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>
    <param name="label" value="$(arg label)"/>
    <param name="target_width_m" value="$(arg target_width_m)"/>
    <param name="target_height_m" value="$(arg target_height_m)"/>

    <!-- Current target HSV range + white assist (OpenCV H: 0-179) -->
    <param name="lower_blue" value="[0, 10, 140]"/>
    <param name="upper_blue" value="[15, 60, 220]"/>
    <param name="lower_white" value="[0, 0, 160]"/>
    <param name="upper_white" value="[180, 85, 255]"/>
    <param name="min_blue_area" value="300.0"/>
    <param name="min_white_area" value="120.0"/>
  </node>

  <node if="$(arg start_mapper)" pkg="doll_map_annotator" type="doll_mapper.py" name="doll_mapper" output="screen">
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="confirm_hits" value="$(arg confirm_hits)"/>
    <param name="one_shot_mode" value="$(arg one_shot_mode)"/>
    <param name="use_latest_tf" value="$(arg use_latest_tf)"/>
    <param name="confidence_min" value="$(arg confidence_min)"/>
    <param name="cluster_radius_m" value="$(arg cluster_radius_m)"/>
    <param name="save_landmarks" value="$(arg save_landmarks)"/>
    <param name="landmark_file" value="$(arg landmark_file)"/>
    <param name="detections_topic" value="/doll_detector/detections"/>
  </node>
</launch>
