<!-- Launch file for the rrt-detector and the assigner -->


<launch>
<arg name="eta" value="0.5"/>
<arg name="Geta" value="2.0"/>
<!-- [auto2d-v0.1.2][2026-04-14] TX2性能优化：降低前沿滤波与分配循环频率 -->
<arg name="rrt_rate" value="5"/>
<param name="namespace_init_count" value="1"/>


  <node pkg="rrt_exploration" type="global_rrt_detector" name="global_detector" output="screen">
  <param name="eta" value="$(arg Geta)"/>
  <param name="map_topic" value="/map"/>
  </node>
  
  <node pkg="rrt_exploration" type="local_rrt_detector" name="local_detector" output="screen">
  <param name="eta" value="$(arg eta)"/>
  <param name="map_topic" value="/map"/>
  <param name="robot_frame" value="base_link"/>
  </node>
 
  
  <node pkg="rrt_exploration" type="filter.py" name="filter" output="screen">
  <param name="map_topic" value="/map"/>
  <param name="info_radius" value="0.8"/> 
  <param name="costmap_clearing_threshold" value="70"/> 
  <param name="cluster_radius" value="0.45"/>
  <param name="around_threshold" value="1200"/>
  <param name="min_info_gain" value="0.25"/>
  <param name="goals_topic" value="/detected_points"/>
  <param name="namespace" value=""/> 
  <param name="n_robots" value="1"/>
  <param name="rate" value="$(arg rrt_rate)"/>
  </node>
  
  <node pkg="rrt_exploration" type="assigner.py" name="assigner" output="screen">
  <param name="map_topic" value="/map"/>
  <param name="global_frame" value="map"/>
  <param name="info_radius" value="1"/> 
  <param name="info_multiplier" value="4.5"/> 
  <param name="distance_multiplier" value="1.8"/>
  <param name="cluster_radius" value="0.4"/>
  <param name="min_frontier_distance" value="0.9"/>
  <param name="direction_probe_distance" value="2.5"/>
  <param name="direction_probe_radius" value="1.2"/>
  <param name="direction_samples" value="16"/>
  <param name="directional_bias_weight" value="2.0"/>
  <param name="momentum_weight" value="1.5"/>
  <param name="revisit_radius" value="1.0"/>
  <param name="revisit_penalty" value="4.0"/>
  <param name="visited_frontier_maxlen" value="200"/>
  <param name="long_range_exponent" value="1.2"/>
  <param name="hysteresis_radius" value="1.2"/> 
  <param name="hysteresis_gain" value="1.0"/> 
  <param name="frontiers_topic" value="/filtered_points"/> 
  <param name="n_robots" value="1"/>
  <param name="namespace" value=""/>
  <param name="delay_after_assignement" value="1.2"/>
  <param name="allow_reassign_busy" value="false"/>
  <param name="goal_reassign_distance" value="0.4"/>
  <param name="reassign_cooldown" value="1.0"/>
  <param name="rate" value="$(arg rrt_rate)"/>
  <param name="plan_service" value="/move_base/GlobalPlanner/make_plan"/><!-- DWA算法需要关闭这一行 -->
  </node>

  <node pkg="rrt_exploration" type="wait_for_fin" name="wait_for_fin" output="screen">
  <param name="waiting_time" value="20"/>

  </node>

</launch>
