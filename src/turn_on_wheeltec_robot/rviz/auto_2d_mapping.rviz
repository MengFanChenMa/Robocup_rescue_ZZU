Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /QrDebugImage1
        - /DollDebugImage1
        - /Footprint1
        - /GlobalPlan1
        - /LocalPlan1
        - /BoundaryPoints1
        - /ClickedPoint1
        - /DetectedPoints1
        - /Frontiers1
        - /Centroids1
        - /GlobalRRT1
        - /LocalRRT1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Map
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Map
      Alpha: 0.7
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /qr_detector/debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: QrDebugImage
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /doll_detector/debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: DollDebugImage
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/Polygon
      Color: 0; 255; 255
      Enabled: true
      Name: Footprint
      Queue Size: 10
      Topic: /move_base/local_costmap/footprint
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.1
      Head Length: 0.2
      Length: 0.2
      Line Style: Lines
      Line Width: 0.06
      Name: GlobalPlan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.03
      Shaft Length: 0.1
      Topic: /move_base/GlobalPlanner/plan
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 255; 0
      Enabled: true
      Head Diameter: 0.1
      Head Length: 0.2
      Length: 0.2
      Line Style: Lines
      Line Width: 0.06
      Name: LocalPlan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.03
      Shaft Length: 0.1
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Value: true
    - Class: rviz/PointStamped
      Color: 0; 170; 255
      Enabled: true
      Name: BoundaryPoints
      Radius: 0.12
      Topic: /clicked_point
      Value: true
    - Class: rviz/PointStamped
      Color: 255; 200; 0
      Enabled: true
      Name: ClickedPoint
      Radius: 0.08
      Topic: /clicked_point
      Value: true
    - Class: rviz/PointStamped
      Color: 255; 0; 255
      Enabled: true
      Name: DetectedPoints
      Radius: 0.07
      Topic: /detected_points
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /frontiers
      Name: Frontiers
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /centroids
      Name: Centroids
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /global_detector_shapes
      Name: GlobalRRT
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /local_detector_shapes
      Name: LocalRRT
      Namespaces:
        {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 12
      Target Frame: map
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1800
  X: 80
  Y: 50
