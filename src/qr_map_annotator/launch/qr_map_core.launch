<launch>
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <arg name="camera_info_topic" default="/usb_cam/camera_info"/>
  <arg name="start_usb_cam" default="true"/>
  <arg name="start_mapper" default="true"/>
  <arg name="map_frame" default="map"/>
  <arg name="detector_mode" default="a4_like" doc="opt: qrcode,a4_like"/>
  <arg name="qr_size_m" default="0.168"/>
  <arg name="detect_rate_hz" default="10.0"/>
  <arg name="use_undistort" default="false"/>
  <arg name="publish_debug_image" default="true"/>

  <!-- A4-like params -->
  <arg name="a4_width_m" default="0.210"/>
  <arg name="a4_height_m" default="0.297"/>
  <arg name="a4_label" default="qr_like"/>
  <arg name="a4_lab_lower_l" default="145"/>
  <arg name="a4_lab_lower_a" default="118"/>
  <arg name="a4_lab_lower_b" default="126"/>
  <arg name="a4_lab_upper_l" default="245"/>
  <arg name="a4_lab_upper_a" default="150"/>
  <arg name="a4_lab_upper_b" default="176"/>
  <arg name="a4_min_white_area" default="1800"/>
  <arg name="a4_min_black_ratio" default="0.003"/>
  <arg name="a4_max_black_ratio" default="0.30"/>
  <arg name="a4_min_aspect" default="0.45"/>
  <arg name="a4_max_aspect" default="2.00"/>
  <arg name="confirm_hits" default="2"/>
  <arg name="one_shot_mode" default="true"/>
  <arg name="save_landmarks" default="true"/>
  <arg name="landmark_file" default="$(env HOME)/.ros/qr_landmarks.json"/>

  <include if="$(arg start_usb_cam)" file="$(find usb_cam)/launch/usb_cam-test.launch"/>

  <node pkg="qr_map_annotator" type="qr_detector.py" name="qr_detector" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="detector_mode" value="$(arg detector_mode)"/>
    <param name="qr_size_m" value="$(arg qr_size_m)"/>
    <param name="detect_rate_hz" value="$(arg detect_rate_hz)"/>
    <param name="use_undistort" value="$(arg use_undistort)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>

    <param name="a4_width_m" value="$(arg a4_width_m)"/>
    <param name="a4_height_m" value="$(arg a4_height_m)"/>
    <param name="a4_label" value="$(arg a4_label)"/>
    <param name="a4_lab_lower_l" value="$(arg a4_lab_lower_l)"/>
    <param name="a4_lab_lower_a" value="$(arg a4_lab_lower_a)"/>
    <param name="a4_lab_lower_b" value="$(arg a4_lab_lower_b)"/>
    <param name="a4_lab_upper_l" value="$(arg a4_lab_upper_l)"/>
    <param name="a4_lab_upper_a" value="$(arg a4_lab_upper_a)"/>
    <param name="a4_lab_upper_b" value="$(arg a4_lab_upper_b)"/>
    <param name="a4_min_white_area" value="$(arg a4_min_white_area)"/>
    <param name="a4_min_black_ratio" value="$(arg a4_min_black_ratio)"/>
    <param name="a4_max_black_ratio" value="$(arg a4_max_black_ratio)"/>
    <param name="a4_min_aspect" value="$(arg a4_min_aspect)"/>
    <param name="a4_max_aspect" value="$(arg a4_max_aspect)"/>
  </node>

  <node if="$(arg start_mapper)" pkg="qr_map_annotator" type="qr_mapper.py" name="qr_mapper" output="screen">
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="confirm_hits" value="$(arg confirm_hits)"/>
    <param name="one_shot_mode" value="$(arg one_shot_mode)"/>
    <param name="save_landmarks" value="$(arg save_landmarks)"/>
    <param name="landmark_file" value="$(arg landmark_file)"/>
    <param name="detections_topic" value="/qr_detector/detections"/>
  </node>
</launch>

